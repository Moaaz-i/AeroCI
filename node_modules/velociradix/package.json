{
  "name": "velociradix",
  "version": "6.2.1",
  "description": "Zero-dependency, ultra-fast C++17 HTTP engine & Node.js web framework. Driven by native event loops (kqueue/epoll), multi-threaded SO_REUSEPORT workers, Radix Trie router, Postman/Swagger UI, SSE, CORS & 20+ built-in middlewares. ~3.5x faster than node:http.",
  "author": "moaaz yahia zakaria",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moaaz-i/Velociradix.git"
  },
  "bugs": {
    "url": "https://github.com/Moaaz-i/Velociradix/issues"
  },
  "homepage": "https://moaaz-i.github.io/Velociradix",
  "type": "module",
  "main": "index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    }
  },
  "keywords": [
    "http",
    "server",
    "c++",
    "cpp",
    "native",
    "router",
    "trie",
    "middleware",
    "sse",
    "kqueue",
    "epoll",
    "high-performance",
    "zero-dependency",
    "framework",
    "express",
    "fastify",
    "swagger",
    "openapi",
    "postman",
    "rest",
    "api",
    "jwt",
    "performance"
  ],
  "files": [
    "index.mjs",
    "index.d.ts",
    "src/velociradix.hpp",
    "src/velociradix.cpp",
    "src/main.cpp",
    "src/addon.cpp",
    "src/templates.mjs",
    "src/postman.html",
    "src/swagger.html",
    "scripts/install.mjs",
    "prebuilds",
    "Makefile",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "scripts": {
    "install": "node scripts/install.mjs",
    "build": "make",
    "test": "make test",
    "bench": "node bench/bench-addon.mjs 4",
    "clean": "make clean",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
